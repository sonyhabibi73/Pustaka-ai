generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum DocumentSource {
  UPLOAD
  YOUTUBE
}

enum DocumentKind {
  PDF
  TEXT
  WORD
  YOUTUBE
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum ProcessingStage {
  UPLOAD_VALIDATION
  TEXT_EXTRACTION
  CHUNKING
  EMBEDDING
  ARTIFACT_GENERATION
}

enum ProcessingJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CardReviewGrade {
  AGAIN
  HARD
  GOOD
  EASY
}

enum ChatMessageRole {
  USER
  ASSISTANT
}

model User {
  id             String       @id @default(cuid())
  name           String?
  email          String?      @unique
  emailVerified  DateTime?
  image          String?
  role           UserRole     @default(USER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  accounts       Account[]
  sessions       Session[]
  documents      Document[]
  flashcards     Flashcard[]
  quizAttempts   QuizAttempt[]
  chatThreads    ChatThread[]

  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Document {
  id                  String          @id @default(cuid())
  userId              String
  title               String          @db.VarChar(255)
  source              DocumentSource
  kind                DocumentKind
  status              DocumentStatus  @default(UPLOADED)
  originalFilename    String?         @db.VarChar(255)
  sourceUrl           String?         @db.Text
  storageKey          String?         @unique @db.Text
  mimeType            String?         @db.VarChar(127)
  sizeBytes           Int?
  sha256              String?         @db.Char(64)
  extractedText       String?         @db.Text
  summaryMarkdown     String?         @db.Text
  summaryGeneratedAt  DateTime?
  processingErrorCode String?         @db.VarChar(64)
  processingError     String?         @db.Text
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks              DocumentChunk[]
  processingJobs      DocumentProcessingJob[]
  flashcards          Flashcard[]
  quizzes             Quiz[]
  chatThreads         ChatThread[]

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([sha256])
}

model DocumentProcessingJob {
  id          String              @id @default(cuid())
  documentId  String
  stage       ProcessingStage
  status      ProcessingJobStatus @default(QUEUED)
  attempt     Int                 @default(0)
  idempotencyKey String            @unique @db.VarChar(128)
  errorCode   String?             @db.VarChar(64)
  errorDetail String?             @db.Text
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime            @default(now())
  document    Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, stage])
  @@index([status, createdAt])
}

model DocumentChunk {
  id           String                          @id @default(cuid())
  documentId   String
  chunkIndex   Int
  content      String                          @db.Text
  tokenCount   Int
  metadata     Json                            @default("{}")
  // Created through the pgvector migration as VECTOR(1536). Prisma treats this
  // extension type as unsupported; vector reads/writes use bound parameters only.
  embedding    Unsupported("vector(1536)")?
  createdAt    DateTime                        @default(now())
  document     Document                        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  quizSources  QuizQuestionSource[]
  messageSources ChatMessageSource[]

  @@unique([documentId, chunkIndex])
  @@index([documentId, chunkIndex])
}

model Flashcard {
  id             String   @id @default(cuid())
  userId         String
  documentId     String
  front          String   @db.Text
  back           String   @db.Text
  sourceChunkIds String[] @default([])
  tags           String[] @default([])
  dueAt          DateTime @default(now())
  intervalDays   Int      @default(0)
  repetitions    Int      @default(0)
  easeFactor     Decimal  @default(2.50) @db.Decimal(4, 2)
  lastReviewedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  reviews        FlashcardReview[]

  @@index([userId, dueAt])
  @@index([documentId])
}

model FlashcardReview {
  id          String          @id @default(cuid())
  flashcardId String
  grade       CardReviewGrade
  reviewedAt  DateTime        @default(now())
  intervalDays Int
  easeFactor  Decimal         @db.Decimal(4, 2)
  flashcard   Flashcard       @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@index([flashcardId, reviewedAt])
}

model Quiz {
  id          String     @id @default(cuid())
  documentId  String
  title       String     @db.VarChar(255)
  description String?    @db.Text
  status      QuizStatus @default(DRAFT)
  timeLimitSec Int?
  generatedAt DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  document    Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  questions   QuizQuestion[]
  attempts    QuizAttempt[]

  @@index([documentId, createdAt])
}

model QuizQuestion {
  id            String       @id @default(cuid())
  quizId        String
  position      Int
  prompt        String       @db.Text
  options       Json
  correctIndex  Int
  explanation   String       @db.Text
  difficulty    Difficulty   @default(MEDIUM)
  createdAt     DateTime     @default(now())
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  sources       QuizQuestionSource[]
  answers       QuizAnswer[]

  @@unique([quizId, position])
}

model QuizQuestionSource {
  questionId String
  chunkId    String
  question   QuizQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  chunk      DocumentChunk  @relation(fields: [chunkId], references: [id], onDelete: Restrict)

  @@id([questionId, chunkId])
  @@index([chunkId])
}

model QuizAttempt {
  id          String    @id @default(cuid())
  quizId      String
  userId      String
  score       Decimal?  @db.Decimal(5, 2)
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers     QuizAnswer[]

  @@index([quizId, userId, startedAt])
}

model QuizAnswer {
  id          String       @id @default(cuid())
  attemptId   String
  questionId  String
  selectedIndex Int?
  isCorrect   Boolean?
  answeredAt  DateTime     @default(now())
  attempt     QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question    QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

model ChatThread {
  id          String        @id @default(cuid())
  userId      String
  documentId  String
  title       String        @db.VarChar(255)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  document    Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]

  @@index([userId, documentId, updatedAt])
}

model ChatMessage {
  id         String          @id @default(cuid())
  threadId   String
  role       ChatMessageRole
  content    String          @db.Text
  promptTokens Int?
  completionTokens Int?
  model      String?         @db.VarChar(100)
  createdAt  DateTime        @default(now())
  thread     ChatThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sources    ChatMessageSource[]

  @@index([threadId, createdAt])
}

model ChatMessageSource {
  messageId String
  chunkId   String
  rank      Int
  message   ChatMessage   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  chunk     DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Restrict)

  @@id([messageId, chunkId])
  @@index([chunkId])
}
